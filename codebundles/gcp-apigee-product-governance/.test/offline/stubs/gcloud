#!/usr/bin/env bash
# Offline stand-in for gcloud, used only by run-offline-tests.sh.
# Only the calls the bundle actually makes are implemented; anything else fails
# loudly so a new dependency on gcloud cannot slip in unnoticed.
set -u

case "$*" in
  *"print-access-token"*)
    if [ "${TOKEN_FAIL:-0}" = "1" ]; then
      echo "ERROR: (gcloud.auth.print-access-token) simulated failure" >&2
      exit 1
    fi
    echo "ya29.offline-test-token"
    ;;
  *"apigee organizations list"*)
    # Deliberately empty: the offline tests resolve the org from the REST
    # response so the projectId filter is what gets exercised.
    exit 1
    ;;
  *)
    echo "gcloud stub: unimplemented call: $*" >&2
    exit 1
    ;;
esac
