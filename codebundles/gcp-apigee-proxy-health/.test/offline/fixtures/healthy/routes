# <path-pattern><TAB><fixture><TAB>[status]   -- paths are relative to /v1,
# matched per segment (* never crosses /). Query after ? is glob-matched.
/organizations	organizations.json	200
/organizations/*/environments/*/apis/*/revisions/*/deployments	status_ready.json	200
/organizations/*/environments/prod/stats/apiproxy?select=sum*	stats_error_split_prod.json	200
/organizations/*/environments/prod/stats/apiproxy?select=p95*	stats_latency_prod.json	200
/organizations/*/environments/prod/stats/apiproxy,response_status_code	stats_http_codes_prod.json	200
/organizations/*/environments/test/stats/*	stats_empty_test.json	200
/organizations/*/environments	environments.json	200
/organizations/*/apis	apis.json	200
/organizations/*/deployments	deployments.json	200
/organizations/*/operations	operations.json	200
